---
const whatsappUrl = 'https://wa.me/542644421666';
const base = import.meta.env.BASE_URL;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Imagen 1 -->
  <div
    id="hero-img-1"
    aria-hidden="true"
    class="absolute inset-0 transition-opacity duration-700 opacity-100"
  >
    <picture class="absolute inset-0">
      <source media="(max-width: 767px)" srcset={`${base}assets/images/hero-1-mobile.png`}>
      <img src={`${base}assets/images/hero-1.png`} alt="" class="w-full h-full object-cover object-center" fetchpriority="high">
    </picture>
  </div>

  <!-- Imagen 2 -->
  <div
    id="hero-img-2"
    aria-hidden="true"
    class="absolute inset-0 transition-opacity duration-700 opacity-0"
  >
    <picture class="absolute inset-0">
      <source media="(max-width: 767px)" srcset={`${base}assets/images/hero-2-mobile.png`}>
      <img src={`${base}assets/images/hero-2.png`} alt="" class="w-full h-full object-cover object-center">
    </picture>
  </div>

  <!-- Contenido slide 1 -->
  <div id="hero-content-1" class="absolute inset-0 z-10 flex items-center transition-opacity duration-700 opacity-100 pointer-events-auto">
    <div class="w-full page-container pt-52 pb-24 text-white text-center md:text-left translate-y-12">

      <p class="fade-in hidden md:block text-xs font-bold uppercase tracking-[0.3em] mb-7 opacity-75">
        San Juan, Argentina · Clínica Veterinaria
      </p>

      <h1 class="fade-in heading-display font-black leading-none mb-4">
        Guardia 24 hs
      </h1>

      <ul class="fade-in flex flex-col gap-2 mb-10 items-center md:items-start">
        <li class="text-lg font-semibold opacity-90">¿Tu mascota se siente mal?</li>
      </ul>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="fade-in inline-flex items-center justify-center gap-2 bg-[#F28C28] text-white font-black px-6 py-3 md:px-9 md:py-4 rounded-full text-base md:text-lg hover:opacity-90 transition-opacity shadow-xl"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Escribinos por WhatsApp</span>
      </a>

    </div>
  </div>

  <!-- Contenido slide 2 -->
  <div id="hero-content-2" class="absolute inset-0 z-10 flex items-center transition-opacity duration-700 opacity-0 pointer-events-none">
    <div class="w-full page-container pt-52 pb-24 text-white text-center md:text-left translate-y-12">

      <p class="hidden md:block text-xs font-bold uppercase tracking-[0.3em] mb-7 opacity-75">
        San Juan, Argentina · Clínica Veterinaria
      </p>

      <h1 class="text-4xl md:text-8xl font-black leading-none mb-8">
        Siempre junto<br>a tus mascotas
      </h1>

      <a
        href="#servicios"
        class="inline-flex items-center justify-center gap-2 bg-[#F28C28] text-white font-black px-6 py-3 md:px-9 md:py-4 rounded-full text-base md:text-lg hover:opacity-90 transition-opacity shadow-xl"
      >
        <span>Ver servicios</span>
      </a>

    </div>
  </div>

  <!-- Indicadores mobile (posición absoluta, fuera de los content divs) -->
  <div class="flex md:hidden absolute bottom-8 left-1/2 -translate-x-1/2 gap-4" style="z-index: 50;">
    <button data-indicator="1" aria-label="Imagen 1" style="cursor: pointer;"
      class="w-5 h-5 rounded-full border-2 border-white bg-white shadow-lg transition-all duration-300 scale-110 ring-2 ring-white ring-offset-2 ring-offset-transparent"
    ></button>
    <button data-indicator="2" aria-label="Imagen 2" style="cursor: pointer;"
      class="w-5 h-5 rounded-full border-2 border-white bg-white/40 shadow-lg transition-all duration-300"
    ></button>
  </div>

  <!-- Indicadores desktop (posición absoluta) -->
  <div class="hidden md:flex absolute bottom-8 right-8 gap-4" style="z-index: 50;">
    <button data-indicator="1" aria-label="Imagen 1" style="cursor: pointer;"
      class="w-6 h-6 rounded-full border-2 border-white bg-white shadow-lg transition-all duration-300 scale-110 ring-2 ring-white ring-offset-2 ring-offset-transparent"
    ></button>
    <button data-indicator="2" aria-label="Imagen 2" style="cursor: pointer;"
      class="w-6 h-6 rounded-full border-2 border-white bg-white/40 shadow-lg transition-all duration-300"
    ></button>
  </div>

  <!-- Flecha scroll down -->
  <a
    href="#nosotros"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white opacity-60 hover:opacity-100 transition-opacity animate-bounce z-20"
    aria-label="Scroll hacia abajo"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>

</section>

<script>
  const img1 = document.getElementById('hero-img-1') as HTMLElement;
  const img2 = document.getElementById('hero-img-2') as HTMLElement;
  const content1 = document.getElementById('hero-content-1') as HTMLElement;
  const content2 = document.getElementById('hero-content-2') as HTMLElement;

  let currentSlide = 1;
  let autoPlayTimer: ReturnType<typeof setInterval>;

  function updateIndicators(activeSlide: number) {
    document.querySelectorAll<HTMLButtonElement>('[data-indicator]').forEach(btn => {
      const isActive = btn.dataset.indicator === String(activeSlide);
      btn.classList.toggle('scale-110', isActive);
      btn.classList.toggle('bg-white', isActive);
      btn.classList.toggle('ring-2', isActive);
      btn.classList.toggle('ring-white', isActive);
      btn.classList.toggle('ring-offset-2', isActive);
      btn.classList.toggle('bg-white/40', !isActive);
    });
  }

  function showImage(index: number) {
    currentSlide = index;
    const isFirst = index === 1;

    img1.classList.toggle('opacity-100', isFirst);
    img1.classList.toggle('opacity-0', !isFirst);
    img2.classList.toggle('opacity-100', !isFirst);
    img2.classList.toggle('opacity-0', isFirst);

    content1.classList.toggle('opacity-100', isFirst);
    content1.classList.toggle('opacity-0', !isFirst);
    content1.classList.toggle('pointer-events-auto', isFirst);
    content1.classList.toggle('pointer-events-none', !isFirst);

    content2.classList.toggle('opacity-100', !isFirst);
    content2.classList.toggle('opacity-0', isFirst);
    content2.classList.toggle('pointer-events-auto', !isFirst);
    content2.classList.toggle('pointer-events-none', isFirst);

    updateIndicators(index);
  }

  function startAutoPlay() {
    autoPlayTimer = setInterval(() => {
      showImage(currentSlide === 1 ? 2 : 1);
    }, 5000);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-indicator]').forEach(btn => {
    btn.addEventListener('click', () => {
      clearInterval(autoPlayTimer);
      showImage(Number(btn.dataset.indicator));
      startAutoPlay();
    });
  });

  startAutoPlay();
</script>
