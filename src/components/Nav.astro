---
const navLinks = [
  { href: '#nosotros',  label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#historias', label: 'Historias' },
  { href: '#ubicacion', label: 'Ubicación' },
  { href: '#contacto',  label: 'Contacto' },
  { href: '#faq',       label: 'FAQ' },
];

const instagramUrl = 'https://www.instagram.com/vet365ok';
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="page-container" style="display: flex; align-items: center; justify-content: space-between; padding-top: 1.25rem; padding-bottom: 1.25rem;">

    <a href="/" aria-label="VET365 – Inicio" style="display: flex; align-items: center; flex-shrink: 0;">
      <span id="logo-wrapper">
        <span id="logo-img-circle">
          <img
            src={`${import.meta.env.BASE_URL}assets/images/logo-nav.png`}
            alt="VET365"
            style="height: 5.5rem; width: auto; object-fit: contain; display: block;"
          />
        </span>
        <span id="logo-name"><span id="logo-vet">VET</span><span id="logo-365">365</span></span>
      </span>
    </a>

    <!-- Links desktop -->
    <ul class="nav-links" style="display: flex; gap: 2.5rem; align-items: center; list-style: none;">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; opacity: 1; transition: opacity 0.2s;"
            onmouseover="this.style.opacity='0.55'"
            onmouseout="this.style.opacity='1'"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA Instagram desktop -->
    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="nav-cta"
      style="display: flex; align-items: center; gap: 0.5rem; background: none; color: inherit; transition: opacity 0.2s; text-decoration: none;"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
    </a>

    <!-- Hamburger mobile -->
    <button id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" style="display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 0.5rem;">
      <span class="ham-bar" style="display: block; width: 24px; height: 2px; background: currentColor; transition: all 0.3s;"></span>
      <span class="ham-bar" style="display: block; width: 24px; height: 2px; background: currentColor; transition: all 0.3s;"></span>
      <span class="ham-bar" style="display: block; width: 24px; height: 2px; background: currentColor; transition: all 0.3s;"></span>
    </button>
  </nav>

  <!-- Menú mobile -->
  <div id="mobile-menu" style="display: none; background: white; border-top: 1px solid #e5e7eb; box-shadow: 0 8px 24px rgba(0,0,0,0.08);">
    <div class="page-container" style="padding-top: 1rem; padding-bottom: 1.5rem;">
      <ul style="list-style: none; display: flex; flex-direction: column; align-items: center;">
        {navLinks.map(link => (
          <li style="width: 100%; text-align: center;">
            <a
              href={link.href}
              style="display: block; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.85rem 0; border-bottom: 1px solid #f3f4f6; color: #333333; text-decoration: none;"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div style="display: flex; justify-content: center; margin-top: 1.25rem;">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.4rem; background-color: #F28C28; color: white; font-size: 0.78rem; font-weight: 800; padding: 0.6rem 1.4rem; border-radius: 9999px; text-decoration: none;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Instagram
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.style.display !== 'none';
    if (mobileMenu) mobileMenu.style.display = isOpen ? 'none' : 'block';
    menuToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    nav?.classList.toggle('menu-open', !isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.style.display = 'none';
      menuToggle?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('menu-open');
    });
  });
</script>

<style>
  #main-nav {
    background: transparent;
    color: white;
  }

  #main-nav.scrolled,
  #main-nav.menu-open {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(20px);
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.07);
    color: #333333;
  }

  #logo-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  #logo-img-circle {
    background: white;
    border-radius: 9999px;
    padding: 0.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    transition: background 0.3s, padding 0.3s, box-shadow 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #logo-name {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: white;
    white-space: nowrap;
    transition: color 0.3s;
  }

  /* Al hacer scroll o abrir menú, quitar el círculo */
  #main-nav.scrolled #logo-img-circle,
  #main-nav.menu-open #logo-img-circle {
    background: transparent;
    padding: 0;
    box-shadow: none;
  }

  #main-nav.scrolled #logo-vet,
  #main-nav.menu-open #logo-vet {
    color: #3D9880;
  }

  #main-nav.scrolled #logo-365,
  #main-nav.menu-open #logo-365 {
    color: #F28C28;
  }

  @media (max-width: 767px) {
    .nav-links  { display: none !important; }
    .nav-cta    { display: none !important; }
    #menu-toggle { display: flex !important; }
  }
</style>
